// Leen Mart — Prisma schema (foundation baseline).
//
// No business entities are modelled here by design. This file establishes the
// conventions every future module must follow (SDD 6):
//
//   * UUID v7 primary keys, generated in the application, not the database, so
//     the ordering guarantee comes from one place (ADR-005).
//   * snake_case tables and columns via @map/@@map; camelCase in TypeScript.
//   * TIMESTAMPTZ everywhere, stored UTC.
//   * Money as BigInt minor units with an explicit currency column. Never Float.
//   * Soft delete via deleted_at on user-visible entities.
//   * Append-only financial and audit tables; corrections are new rows.
//
// The two tables below are platform infrastructure rather than business
// entities, and both are needed before any module can be built safely.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm, btree_gist]
}

/// Transactional outbox (SDD 4.2 / ADR-011).
///
/// Side effects are written in the same transaction as the business change, then
/// relayed asynchronously by the worker. This is what guarantees "if the order
/// committed, the notification will eventually send" without a distributed
/// transaction.
///
/// **Range-partitioned monthly on `created_at`** (SDD 6.4/6.5), applied in
/// `20260811233000_partition_audit_and_outbox`. The composite primary key is
/// forced by PostgreSQL for the same reason as `AuditLog`'s: a partitioned
/// table's primary key must contain every partition-key column. Nothing reads
/// this table yet, so no query is affected.
model OutboxEvent {
  id            String    @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(100)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(150)
  payload       Json
  metadata      Json?
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Partial index: the relay only ever scans unprocessed rows, so the index
  // stays small no matter how large the table grows.
  @@id([id, createdAt])
  @@index([processedAt, occurredAt], map: "idx_outbox_unprocessed")
  @@index([aggregateType, aggregateId], map: "idx_outbox_aggregate")
  // SDD 6.4 lists `(created_at)` for this table alongside `audit_logs`; it was
  // absent until now. Partitioning makes it earn its place twice over — it is
  // also the column every partition-pruned scan filters on.
  @@index([createdAt], map: "idx_outbox_created_at")
  @@map("outbox_events")
}

/// Identity module (first business module).
///
/// A single fixed role per user is sufficient for the nine roles the SDD's
/// role hierarchy defines (SDD 8.1); no permissions/roles join table is
/// modelled since nothing beyond fixed membership in one of these roles has
/// been requested. The permission matrix these roles feed (SDD 8.2) is
/// separate, out-of-scope-here policy, not part of this enum.
enum Role {
  CUSTOMER
  VENDOR_OWNER
  VENDOR_MANAGER
  VENDOR_STAFF
  SUPER_ADMIN
  CATALOGUE_MODERATOR
  FINANCE_ADMIN
  RISK_ANALYST
  SUPPORT_AGENT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
}

model User {
  id              String     @id @db.Uuid
  email           String?    @unique @db.VarChar(254)
  passwordHash    String?    @map("password_hash")
  phone           String?    @unique @db.VarChar(20)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  otps          Otp[]
  vendorProfile VendorProfile?
  mfaSecret     MfaSecret?
  mfaChallenges MfaChallenge[]
  addresses     Address[]
  cart          Cart?
  // Two named relations because a KYC submission records the reviewer who
  // claimed it and the administrator who decided it as separate people.
  kycReviewed   VendorKycSubmission[] @relation("KycReviewer")
  kycDecided    VendorKycSubmission[] @relation("KycDecider")

  @@map("users")
}

/// Opaque, hashed refresh tokens (SDD 6.1).
///
/// The raw token is never persisted, only its SHA-256 hash — the same
/// principle as a password, except Argon2 would be wasted work on a value
/// that is already 256 bits of randomness. `replacedById` records rotation so
/// a replayed, already-rotated token is a detectable signal, not just a
/// rejected one.
///
/// `family_id` is the rotation lineage that signal acts on (SDD 7.2: on
/// reuse detection "the entire session family is revoked"). A fresh login
/// roots a family at its own id and every rotation carries it forward, so a
/// family is exactly one login and its descendants — not every session the
/// user holds, which SDD 7.2 revokes under different triggers entirely.
/// Not a foreign key to itself: the root row can be deleted by retention
/// long before its descendants, and a family id that outlives its root is
/// correct rather than dangling.
model RefreshToken {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user")
  // Serves the one-statement family revocation on reuse detection. Plain
  // rather than partial: `family_id` is high-cardinality, so a family lookup
  // is already a handful of rows before the `revoked_at IS NULL` filter
  // narrows it to the single live one.
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@map("refresh_tokens")
}

/// One-time phone verification codes (SDD 7.1/7.3, Milestone 3 Step 2).
///
/// `codeHash` is the only representation of the code ever persisted — never
/// the raw 6-digit value, hashed with Argon2id (same reasoning as password
/// storage: the code space is small enough that a fast hash would be
/// brute-forceable offline). `attempts`/`expiresAt`/`consumedAt` mirror the
/// domain `Otp` entity's own invariants (5-minute validity, 5 max attempts,
/// single use) exactly; this table only stores that state, it never decides
/// it.
model Otp {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_otps_user")
  @@map("otps")
}

/// An administrator's TOTP secret (SDD 7.1: MFA is mandatory for every admin
/// role, always — never optional). `encrypted_secret` is ciphertext, never
/// the raw base32 secret; the key and cipher are out of scope for this
/// persistence-only chunk (Milestone 3 Step 5B) and land with the TOTP
/// service that first writes to this table. `user_id` is unique: exactly one
/// secret per user, the same one-to-one shape as `vendors.user_id`.
/// `confirmed_at` is null until the admin completes enrollment by proving
/// possession of the secret — a later chunk's concern, not this table's.
///
/// No `algorithm`/`digits`/`period` columns: TOTP's parameters are fixed
/// platform constants (approved design), not per-user configuration. No
/// recovery-code columns: recovery is operator-assisted break-glass (approved
/// design), which does not persist codes here.
model MfaSecret {
  id              String    @id @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  encryptedSecret String    @map("encrypted_secret")
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_secrets")
}

/// The record of an admin who has passed step 1 (password) of login and now
/// has one window to prove TOTP possession (SDD 7.1: mandatory TOTP, always).
/// Same shape SDD 7.3 already specifies for phone-OTP challenges — hashed,
/// 5-minute TTL, single use, max 5 attempts — applied here because the SDD
/// gives no separate MFA-challenge spec of its own. `token_hash` is a
/// high-entropy opaque bearer token's hash, the same pattern as
/// `refresh_tokens.token_hash`, not a low-entropy code like `otps.code_hash`.
/// No TOTP code or secret is ever stored here: verification is computed live
/// against `mfa_secrets`, never persisted mid-flight.
model MfaChallenge {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_mfa_challenges_user")
  @@map("mfa_challenges")
}

/// Vendor module (SDD 5, module 3).
///
/// The onboarding lifecycle of SDD 15.1. Deliberately not `UserStatus`: a
/// vendor answers a longer, KYC-driven question than a user account ever
/// does, and one shared type would make impossible states (a `LOCKED`
/// vendor, a `KYC_UNDER_REVIEW` user) representable.
enum VendorStatus {
  REGISTERED
  KYC_SUBMITTED
  KYC_UNDER_REVIEW
  KYC_REJECTED
  KYC_APPROVED
  ACTIVE
  SUSPENDED
  TERMINATED
}

/// S3-2, ASM-06: "a vendor is on exactly one plan at a time — `COMMISSION`
/// or `SUBSCRIPTION` — with the plan determining an effective commission
/// rate." Only these two values — no category-specific or custom plan is
/// approved for V1 (D-S3-01).
enum VendorPlan {
  COMMISSION
  SUBSCRIPTION
}

/// A vendor's onboarding record (SDD 15.1).
///
/// `user_id` is unique: a single account may hold at most one vendor
/// profile, which is what makes the application's `findByUserId` duplicate
/// guard a database guarantee rather than a race-prone check. The foreign
/// key to `users` is one of the two module-crossing keys SDD 6.7 explicitly
/// permits (`users`/`vendors` are the shared identity anchors).
///
/// Only the columns registration actually writes exist here. KYC documents,
/// shops, business hours and trust scores (SDD 5, module 3) arrive with the
/// chunks that implement them.
///
/// `plan` (S3-2) defaults every vendor — new and pre-existing alike — to
/// `COMMISSION`: the baseline plan with no special arrangement, never the
/// free `SUBSCRIPTION` tier, which nothing has qualified a pre-existing
/// vendor for. There is deliberately no `changePlan()` anywhere yet —
/// switching plans is a real commercial action (billing, proration) that
/// D-S3-01 does not approve building yet; the column exists so commission
/// resolution has something to read.
model VendorProfile {
  id        String       @id @db.Uuid
  userId    String       @unique @map("user_id") @db.Uuid
  status    VendorStatus @default(REGISTERED)
  plan      VendorPlan   @default(COMMISSION)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycSubmissions VendorKycSubmission[]
  products       Product[]

  @@map("vendors")
}

/// A customer's saved delivery address (SDD Stage 1: "customer profile and
/// address book"). No `customer` FR elaborates a distinct schema, so the
/// field list follows the standard e-commerce address-book shape SDD's
/// architecture already anticipates (Pincode as a first-class concept).
///
/// No lat/lng columns: no geocoding provider is configured yet, and
/// unpopulated nullable columns would be exactly the kind of speculative
/// field this schema otherwise avoids — added when the geocoding chunk
/// actually needs them.
///
/// Soft delete via `deleted_at`, per this schema's own stated convention
/// (top of file) — an address a customer has used on a past order must
/// remain resolvable, not vanish out from under order history.
///
/// `is_default` is enforced to at most one **active** row per user by
/// `idx_addresses_one_default_per_user`, a partial unique index added by
/// hand in this model's migration (Prisma's schema DSL has no `WHERE`
/// clause for indexes) — the same "database is the final arbiter of a
/// concurrent race" pattern `mfa_challenges.consumeIfActive` already
/// established, not a new one.
model Address {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  recipientName String    @map("recipient_name") @db.VarChar(100)
  phone         String    @db.VarChar(20)
  line1         String    @map("line_1") @db.VarChar(200)
  line2         String?   @map("line_2") @db.VarChar(200)
  city          String    @db.VarChar(100)
  state         String    @db.VarChar(100)
  pincode       String    @db.VarChar(6)
  landmark      String?   @db.VarChar(200)
  label         String    @db.VarChar(50)
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_addresses_user")
  @@map("addresses")
}

/// Immutable admin action log (SDD 18.4).
///
/// A domain artefact rather than an application log: queryable by admins,
/// retained eight years, and legally significant in a dispute.
///
/// Append-only: UPDATE, DELETE and TRUNCATE are all rejected by triggers added
/// in `20260811120000_audit_log_immutability`, not here — Prisma's schema DSL
/// cannot express a trigger, so the migration is the only place this control
/// can live. Corrections are new rows describing the correction, never edits.
///
/// **Range-partitioned monthly on `created_at`** (SDD 6.4/6.5), applied in
/// `20260811233000_partition_audit_and_outbox`. Prisma cannot express
/// `PARTITION BY RANGE` either, so that migration is likewise the only place
/// the partitioning itself lives — this model describes the resulting shape so
/// the generated client stays accurate.
///
/// The composite primary key is a consequence, not a choice: PostgreSQL
/// requires every unique or primary key on a partitioned table to contain all
/// partition-key columns, so `(id)` necessarily becomes `(id, created_at)`.
/// `id` remains the domain identity — no repository query looks a row up by
/// primary key, so nothing in the application observes the difference.
model AuditLog {
  id             String   @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actorRole      String   @map("actor_role") @db.VarChar(50)
  impersonatedBy String?  @map("impersonated_by") @db.Uuid
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String?  @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  reason         String?
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent")
  requestId      String?  @map("request_id") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([id, createdAt])
  @@index([actorId, createdAt], map: "idx_audit_actor")
  @@index([entityType, entityId, createdAt], map: "idx_audit_entity")
  @@index([createdAt], map: "idx_audit_created_at")
  @@map("audit_logs")
}

/// The three documents V1 requires at KYC (SDD 15.1's document set, narrowed
/// by decision D1). Aadhaar, FSSAI and shop/establishment proof are absent by
/// decision, not oversight — each waits on its own gate.
enum KycDocumentType {
  PAN
  BANK_ACCOUNT_PROOF
  GSTIN
}

/// Mirrors `KycDocument`'s two states. A reserved object key is not yet a
/// document: the row exists so the upload has somewhere to land, and only
/// becomes reviewable once the client has finished writing the object.
enum KycDocumentUploadStatus {
  AWAITING_UPLOAD
  UPLOADED
}

/// The closed rejection vocabulary (decision D7). The SDD defines none — its
/// only rejection codes are §15.2's product-moderation ones, a different
/// machine entirely.
enum KycRejectionReason {
  DOCUMENT_UNCLEAR
  DOCUMENT_INVALID
  DETAILS_MISMATCH
  BANK_DETAILS_MISMATCH
  DUPLICATE_IDENTITY
  OTHER
}

/// One KYC submission by one vendor (`VendorKyc`), with its review folded in.
///
/// **The review is columns on this row, not a table.** A submission has at
/// most one review and a review cannot outlive its submission, so a separate
/// table would buy a join and an extra way for the two to disagree, and buy
/// nothing else. `KycReview` is a value inside the aggregate, not an entity
/// with its own identity.
///
/// **No status column.** The lifecycle SDD 15.1 draws lives on `vendors`
/// (`VendorStatus`), and this row deliberately does not restate it — the
/// domain made the same choice for the same reason. What the review columns
/// record is who did what and when, which the status cannot express.
///
/// `reviewed_by` and `decided_by` are separate on purpose: SDD 15.1 records
/// the identity of the human who *decided*, and the project's approved model
/// does not require that to be whoever claimed the queue item.
///
/// **What is not here is as deliberate as what is.** No plaintext PAN and no
/// plaintext bank account number: both exist only inside the client-encrypted
/// documents in object storage. This row keeps a one-way fingerprint for
/// SEC-17 duplicate detection and the last four characters SDD 12.3 displays
/// by default — which *is* the masked form, so it discloses nothing the UI
/// does not already show. GSTIN is stored whole because BR-13 requires it
/// whole (GSTR-8, tax invoices); see the domain entity for what that costs.
model VendorKycSubmission {
  id               String              @id @db.Uuid
  vendorId         String              @map("vendor_id") @db.Uuid
  /// HMAC-SHA256 hex. Indexed, never unique — see the migration for why.
  panFingerprint   String              @map("pan_fingerprint") @db.VarChar(64)
  panLast4         String              @map("pan_last4") @db.VarChar(4)
  gstin            String              @db.VarChar(15)
  bankFingerprint  String              @map("bank_fingerprint") @db.VarChar(64)
  bankAccountLast4 String              @map("bank_account_last4") @db.VarChar(4)
  ifsc             String              @db.VarChar(11)
  reviewedBy       String?             @map("reviewed_by") @db.Uuid
  startedAt        DateTime?           @map("started_at") @db.Timestamptz(6)
  decidedBy        String?             @map("decided_by") @db.Uuid
  decidedAt        DateTime?           @map("decided_at") @db.Timestamptz(6)
  rejectionReason  KycRejectionReason? @map("rejection_reason")
  rejectionNote    String?             @map("rejection_note")
  submittedAt      DateTime            @map("submitted_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  // `Restrict`, not `Cascade` or `SetNull`: SDD 15.1 requires the deciding
  // human's identity to be recorded, and a record that can lose the name is
  // not a record of it.
  reviewer  User?         @relation("KycReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  decider   User?         @relation("KycDecider", fields: [decidedBy], references: [id], onDelete: Restrict)
  documents KycDocument[]

  /// The composite-foreign-key target that stops a document drifting to
  /// another vendor's submission. Redundant as a uniqueness claim — `id` is
  /// already the primary key — and present only so `(kyc_id, vendor_id)` has
  /// something to reference.
  @@unique([id, vendorId], map: "uq_vendor_kyc_id_vendor")
  /// The vendor's attempt history, newest first — the only ordering anything
  /// asks for.
  @@index([vendorId, submittedAt(sort: Desc)], map: "idx_vendor_kyc_vendor_history")
  @@index([panFingerprint], map: "idx_vendor_kyc_pan_fingerprint")
  @@index([bankFingerprint], map: "idx_vendor_kyc_bank_fingerprint")
  @@map("vendor_kyc_submissions")
}

/// Metadata for one client-encrypted KYC document (`KycDocument`).
///
/// **Metadata only — never bytes.** SDD 12.2 keeps files out of the API tier
/// entirely; the object lives in the private KYC bucket and this row holds the
/// reference to it.
///
/// `wrapped_data_key` is the data key wrapped by the KMS CMK (SDD 12.3:
/// "stored beside the object reference"). `BYTEA`, because it is opaque binary
/// that nothing queries or orders by — hex or base64 in a text column would be
/// a third of a page larger per row and invite someone to treat it as a
/// string. The *plaintext* data key is never here, and the domain entity
/// redacts the wrapped one from its serialised form.
///
/// `vendor_id` is denormalised and constrained, not merely copied: the
/// composite foreign key below makes it impossible for a document to name a
/// vendor its parent submission does not.
model KycDocument {
  id             String                  @id @db.Uuid
  kycId          String                  @map("kyc_id") @db.Uuid
  vendorId       String                  @map("vendor_id") @db.Uuid
  type           KycDocumentType
  objectKey      String                  @map("object_key") @db.VarChar(1024)
  wrappedDataKey Bytes                   @map("wrapped_data_key")
  contentType    String                  @map("content_type") @db.VarChar(255)
  sizeBytes      Int                     @map("size_bytes")
  status         KycDocumentUploadStatus @default(AWAITING_UPLOAD)
  uploadedAt     DateTime?               @map("uploaded_at") @db.Timestamptz(6)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  submission VendorKycSubmission @relation(fields: [kycId, vendorId], references: [id, vendorId], onDelete: Cascade)

  /// The domain refuses a submission carrying one type twice; this is the
  /// database saying the same thing, so a concurrent write cannot slip a
  /// second one past a check that already passed.
  @@unique([kycId, type], map: "uq_kyc_documents_one_per_type")
  @@index([vendorId], map: "idx_kyc_documents_vendor")
  @@map("kyc_documents")
}

/// Catalogue risk tier (SDD 15.2). Drives admin queue prioritisation; under
/// the Stage-2 decision that every vendor is trust tier `NEW`, it does not
/// yet route anything to auto-approval.
///
/// Assigned explicitly per category and never inherited: inheritance would
/// mean moving a subtree silently reclassified every listing beneath it.
enum CategoryRiskLevel {
  LOW
  MEDIUM
  RESTRICTED
}

/// Catalogue taxonomy (SDD 5 module 4, SDD 6.3).
///
/// Adjacency list (`parent_id`) plus a materialised `path`, exactly the shape
/// SDD 6.3 prescribes. The path is a denormalised `uuid[]` of ancestors rather
/// than `ltree`: the array needs no extension, is natively expressible in
/// Prisma, and is GIN-indexable, whereas `ltree` would require a new extension
/// and `Unsupported(...)` typing that the generated client cannot select.
///
/// Platform-owned, not vendor-owned: there is no tenant column, so this table
/// is deliberately outside `TENANT_SCOPED_MODELS` and carries no RLS policy.
/// The public catalogue reads it without any tenant context at all.
///
/// The three `requires_*` booleans are SDD 15.2's mandatory-field completeness
/// screen (HSN, country of origin, net quantity — BR-15/BR-21), made
/// category-conditional. They are explicit columns rather than
/// `category_attributes` rows because they are a closed, statutory set, not
/// open-shaped per-category data.
///
/// **FSSAI (BR-17) is deliberately absent.** Food categories will eventually
/// need a licence-conditional requirement, but that needs vendor licence
/// storage with a number and an expiry that does not exist anywhere in this
/// schema. Adding a `requires_fssai` flag now would create a requirement
/// nothing could satisfy. Deferred compliance work, tracked, not forgotten.
model Category {
  id       String   @id @db.Uuid
  parentId String?  @map("parent_id") @db.Uuid
  /// Ancestor ids, root-first, excluding self. Empty for a root.
  path     String[] @db.Uuid
  /// 1 for a root, 5 at most. Always `cardinality(path) + 1`.
  depth    Int      @db.SmallInt
  name     String   @db.VarChar(120)
  /// Stable public URL key. Immutable once assigned — a slug that changes is
  /// not a stable URL.
  slug     String   @db.VarChar(140)

  riskLevel               CategoryRiskLevel @default(LOW) @map("risk_level")
  requiresHsn             Boolean           @default(false) @map("requires_hsn")
  requiresCountryOfOrigin Boolean           @default(false) @map("requires_country_of_origin")
  requiresNetQuantity     Boolean           @default(false) @map("requires_net_quantity")

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// `Restrict`, not `Cascade`: rows are soft-deleted, so this key should
  /// never fire — and if a hard delete is ever attempted, the database
  /// refuses rather than silently orphaning a subtree.
  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]          @relation("CategoryTree")
  attributes CategoryAttribute[]
  products   Product[]

  @@index([parentId], map: "idx_categories_parent")
  @@index([path], type: Gin, map: "idx_categories_path")
  @@map("categories")
}

/// The closed attribute vocabulary (S2-2b). Four types, deliberately: anything
/// richer becomes a schema language, and a schema language stored in the
/// database is a validation engine nobody can review.
enum CategoryAttributeType {
  STRING
  NUMBER
  BOOLEAN
  ENUM
}

/// Per-category product attribute *definitions* (SDD 5 module 4, FR-14).
///
/// Definitions only. The **values** a product supplies against these live as
/// JSONB on the product (SDD 6.1: "JSONB ... only for genuinely open-shaped
/// data: per-category product attributes"), and arrive with the product model
/// in a later chunk. Nothing here anticipates that shape.
///
/// `key` and `data_type` are immutable once written. A key that can change is
/// not a stable identifier for the values that will reference it, and a type
/// that can change under stored values is a data-corruption path with no
/// migration story.
///
/// `unit` and `options` are type-conditional, and the two CHECK constraints in
/// this model's migration enforce that as an equivalence rather than a pair of
/// implications: ENUM must carry options, and no other type may carry any.
model CategoryAttribute {
  id         String                @id @db.Uuid
  categoryId String                @map("category_id") @db.Uuid
  key        String                @db.VarChar(60)
  label      String                @db.VarChar(120)
  dataType   CategoryAttributeType @map("data_type")
  isRequired Boolean               @default(false) @map("is_required")
  /// Permitted for NUMBER only.
  unit       String?               @db.VarChar(20)
  /// Non-empty for ENUM, empty for every other type.
  options    String[]              @db.VarChar(80)
  /// A caller-supplied ordering hint. Ties are allowed; reads order by
  /// `(position, key)` so the result is deterministic regardless.
  position   Int                   @db.SmallInt

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// `Restrict` for the same reason `Category.parent` uses it: rows are
  /// soft-deleted, so this key should never fire — and if a hard delete is
  /// ever attempted, the database refuses rather than orphaning the row.
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId], map: "idx_category_attributes_category")
  @@map("category_attributes")
}

/// The moderation lifecycle (SDD 15.2). Only `DRAFT` is reachable in S2-3a —
/// no code transitions a product anywhere else yet. The remaining states
/// S2-5 adds the moderation core (SDD 15.2): `PENDING_REVIEW`, `APPROVED`,
/// `REJECTED`. `PUBLISHED`, `UNPUBLISHED` and `DELISTED` are still withheld —
/// those belong to the publish step and the media-gated "product publication
/// is blocked while any of its media is not READY" rule (SDD 12.2), neither of
/// which exists yet — the same reasoning that withheld this whole enum until
/// S2-3a, applied again at the next boundary.
enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Why a product was rejected (S2-5). SDD 15.2 requires "a structured reason
/// code plus optional free text" but defines no vocabulary for it — this set
/// is a project decision, kept deliberately small, mirroring
/// `KycRejectionReason`'s "small closed rejection reason enum" precedent.
///
/// Every member is reachable by a human reviewer's judgement alone, with no
/// automated engine behind it: S2-5 builds no NSFW classifier, price-anomaly
/// detector or keyword-policy engine (SDD 15.2's automatic pre-screening list
/// beyond mandatory-field completeness is explicitly out of scope), so there
/// is no `NSFW_IMAGE` or `PRICE_ANOMALY_DETECTED` member — a reviewer's own
/// look at the listing is the only thing that reaches any of these six.
///
///  * `INCOMPLETE_MANDATORY_FIELDS` — the one automated pre-screening check
///    S2-5 actually implements (HSN/country of origin/net quantity, per the
///    product's category `CategoryRequirements` — BR-15/BR-21); also
///    reachable by a human reviewer noticing the same gap.
///  * `POLICY_VIOLATION` — prohibited content or a category-policy breach
///    (BR-18), judged by the reviewer rather than an automated keyword check.
///  * `MISLEADING_LISTING` — the name, description or attributes misrepresent
///    the product.
///  * `DUPLICATE_LISTING` — this vendor (or another) already lists the same
///    product, judged by the reviewer rather than an automated hash match.
///  * `PRICING_ISSUE` — a price that is implausible for the category, judged
///    by the reviewer rather than an automated anomaly score.
///  * `OTHER` — the escape hatch. Unlike `KycRejectionReason.OTHER`, this
///    member needs no special-cased "must carry an explanation" rule: SDD
///    15.2 makes the free-text note optional for every reason alike, `OTHER`
///    included, so there is nothing for one member to require that the
///    others do not.
enum ProductRejectionReason {
  INCOMPLETE_MANDATORY_FIELDS
  POLICY_VIOLATION
  MISLEADING_LISTING
  DUPLICATE_LISTING
  PRICING_ISSUE
  OTHER
}

/// The upload/processing lifecycle of one `ProductMedia` row (S2-6a, SDD
/// 12.2). Only the two states S2-6a's own code can produce are declared —
/// `AWAITING_UPLOAD` (§12.2 step 2, "a pending media_asset row") and
/// `PROCESSING` (once the client confirms the upload landed) — the same
/// discipline `ProductStatus` already applies: a member nothing can produce
/// would be a guess about a feature that does not exist yet.
///
/// `READY` and `FAILED` arrive with S2-6b (the async worker, D-S2-6-A/K) —
/// exactly as `ProductStatus` grew `PENDING_REVIEW`/`APPROVED`/`REJECTED` in
/// S2-5 rather than being declared upfront in S2-3a.
///
/// Only `AWAITING_UPLOAD` and `READY` are named by the SDD (12.2's own
/// pipeline: a pending row, then `status = READY`). `PROCESSING` and `FAILED`
/// are implementation states this milestone adds to represent asynchronous
/// processing honestly — the SDD's pipeline is not instantaneous, and a
/// status column that could only ever say "pending" or "done" would be lying
/// about every upload while its worker job is actually running or has
/// genuinely failed.
enum ProductMediaStatus {
  AWAITING_UPLOAD
  PROCESSING
  /// SDD-named terminal state: re-encoded, EXIF/GPS-stripped, all 8 variants
  /// generated and stored.
  READY
  /// Implementation state (S2-6b): processing could not complete. Carries a
  /// closed-vocabulary `failureReason` code, never the raw exception —
  /// `ProductMedia.markFailed` is the only writer.
  FAILED
}

/// The two output encodings SDD 12.2's variant matrix requires (200/400/800/
/// 1600 px × WebP/AVIF, D-S2-6-F) — a closed, fixed set, so a native enum
/// rather than free text.
enum ProductMediaVariantFormat {
  WEBP
  AVIF
}

/// The marketing entity (SDD 5 module 4, SDD 6.3 "Product ↔ Variant").
/// Vendor-owned and tenant-scoped — unlike `Category`, which is
/// platform-owned. `ProductVariant` is the sellable unit; every product has
/// at least one, enforced by `CreateProductUseCase` creating both in one
/// transaction (S2-3 D-7), never by a constraint a single-row `INSERT` could
/// satisfy on its own.
///
/// `hsn_code`/`country_of_origin`/`net_quantity` are stored with basic
/// length limits only (S2-3 D-2) — this table never checks them against the
/// category's `requirements` flags. That check exists now, in
/// `SubmitProductForReviewUseCase` (S2-5), at the moment a vendor asks to
/// enter `PENDING_REVIEW` — not here, and not on every edit: a `DRAFT` may
/// stay incomplete indefinitely, exactly as S2-3 D-2 anticipated.
///
/// `attribute_values` is genuinely open-shaped per SDD 6.1's JSONB
/// principle: keys are `category_attributes.key` under this product's
/// category, values are whatever that attribute's `data_type` allows. Not
/// validated against the definitions in S2-3a, for the same reason the
/// statutory fields above are not — that validation belongs to submission.
model Product {
  id              String        @id @db.Uuid
  vendorId        String        @map("vendor_id") @db.Uuid
  categoryId      String        @map("category_id") @db.Uuid
  name            String        @db.VarChar(200)
  brand           String?       @db.VarChar(120)
  description     String?
  hsnCode         String?       @map("hsn_code") @db.VarChar(8)
  countryOfOrigin String?       @map("country_of_origin") @db.VarChar(2)
  netQuantity     String?       @map("net_quantity") @db.VarChar(40)
  attributeValues Json          @default("{}") @map("attribute_values")
  status          ProductStatus @default(DRAFT)

  /// `rejectionReason` is required while `status = REJECTED` and forbidden
  /// otherwise; `rejectionNote` is optional even while `REJECTED` — SDD 15.2,
  /// verbatim: "a structured reason code plus optional free text".
  /// `chk_products_rejection_requires_reason_and_note` is the copy of both
  /// rules that survives an application bug. Both are cleared on every fresh
  /// `submitForReview` (S2-5): a resubmission is not still carrying the
  /// verdict on the attempt before it.
  rejectionReason ProductRejectionReason? @map("rejection_reason")
  rejectionNote   String?                 @map("rejection_note")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  vendor   VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  /// `Restrict`, matching `CategoryAttribute.category`: a category with live
  /// products must not vanish out from under them.
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  media    ProductMedia[]

  /// The composite-foreign-key target `ProductVariant` pins its own
  /// denormalised `vendor_id` against — the exact technique
  /// `vendor_kyc_submissions`/`kyc_documents` already use, so the database
  /// itself refuses a variant whose vendor does not match its product's.
  @@unique([id, vendorId], map: "uq_products_id_vendor")
  @@index([vendorId, status], map: "idx_products_vendor_status")
  @@index([categoryId, status], map: "idx_products_category_status")
  @@map("products")
}

/// The sellable unit (SDD 6.3, ASM-15, FR-10/11) — SKU, price, unit of
/// measure and quantity step live here; stock does not (SDD 6.3's own
/// decision: a separate `inventory` row per variant, a later chunk).
///
/// `vendor_id` is denormalised from `Product.vendorId`, not merely copied:
/// the composite foreign key below makes it impossible for a variant to name
/// a vendor its parent product does not — identical reasoning to
/// `KycDocument.vendorId`'s relationship to `VendorKycSubmission`. The
/// column exists so RLS and the `(vendor_id, sku)` uniqueness SDD 6.4
/// specifies are both a plain column comparison, never a subquery to
/// `products`.
model ProductVariant {
  id            String @id @db.Uuid
  productId     String @map("product_id") @db.Uuid
  vendorId      String @map("vendor_id") @db.Uuid
  sku           String @db.VarChar(64)
  name          String @db.VarChar(120)
  /// Integer minor units (SDD 6.1) — paise, never a float or NUMERIC.
  priceAmount   BigInt @map("price_amount")
  priceCurrency String @default("INR") @map("price_currency") @db.VarChar(3)
  /// No closed vocabulary (S2-3 D-3) — the SDD gives examples ("per kg",
  /// "250 g steps") but never an enumerable set, so this is free text rather
  /// than a guessed enum.
  unitOfMeasure String @map("unit_of_measure") @db.VarChar(40)
  quantityStep  Int    @map("quantity_step")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// The composite FK: both halves must match the same `Product` row.
  product   Product    @relation(fields: [productId, vendorId], references: [id, vendorId], onDelete: Restrict)
  inventory Inventory?

  /// SDD 6.4's own indexing table: a vendor's own SKU must be unique to
  /// them, never globally — two different vendors may both use `SKU-001`.
  @@unique([vendorId, sku], map: "uq_product_variants_vendor_sku")
  /// The composite-foreign-key target `Inventory` pins its own denormalised
  /// `vendor_id` against — the same technique `uq_products_id_vendor` exists
  /// for one level up, so the database itself refuses an inventory row whose
  /// vendor does not match its variant's. Additive: `id` is already unique,
  /// so this constrains nothing that was previously allowed.
  @@unique([id, vendorId], map: "uq_product_variants_id_vendor")
  @@index([productId], map: "idx_product_variants_product")
  @@map("product_variants")
}

/// One uploaded media asset for a product (S2-6a, SDD 12.1/12.2). Vendor-
/// owned and tenant-scoped, always reached through its parent `Product` —
/// SDD 6.2's entity diagram draws `product_media` as a sibling of
/// `product_variants`, both children of `products`, **not** nested under a
/// variant (products carry media; variants carry price/stock).
///
/// `vendor_id` is denormalised from `Product.vendorId`, the same composite-FK
/// technique `ProductVariant.vendorId` already uses — the database itself
/// refuses a media row whose vendor does not match its product's.
///
/// Carries no filename, no caption, no display position and no dimensions —
/// none of these are SDD-specified (S2-6 inspection R5), and none is needed
/// yet: S2-6a's own API surface has nothing that would read them.
///
/// `objectKey` is never accepted from a caller — `CreateProductMediaUploadIntentUseCase`
/// derives it server-side, the same discipline `CreateKycUploadIntentUseCase`'s
/// `objectKeyFor` already establishes, so a vendor cannot aim an upload at
/// another vendor's (or another product's) object.
model ProductMedia {
  id          String             @id @db.Uuid
  productId   String             @map("product_id") @db.Uuid
  vendorId    String             @map("vendor_id") @db.Uuid
  objectKey   String             @map("object_key")
  contentType String             @map("content_type") @db.VarChar(100)
  sizeBytes   Int                @map("size_bytes")
  status      ProductMediaStatus @default(AWAITING_UPLOAD)

  /// S2-6b. A closed, internal vocabulary of short codes this module itself
  /// defines (e.g. `SVG_REJECTED`, `CONTENT_TYPE_MISMATCH`) — never a raw
  /// exception message or stack trace, so this is safe to eventually surface
  /// to the vendor who owns the row. `NULL` unless `status = FAILED`;
  /// `ProductMedia.markFailed`/`retryProcessing` are the only writers.
  failureReason String? @map("failure_reason") @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// The composite FK: both halves must match the same `Product` row —
  /// identical technique to `ProductVariant.product` above.
  product Product @relation(fields: [productId, vendorId], references: [id, vendorId], onDelete: Restrict)

  /// S2-6b's 8 derived variants, one row each. Independent of `objectKey`
  /// above, which stays the original upload — never republished as-is (SDD
  /// 12.2: every served file is freshly re-encoded).
  variants ProductMediaVariant[]

  /// The composite-foreign-key target `ProductMediaVariant` pins its own
  /// denormalised `vendor_id` against (S2-6b) — the same technique
  /// `uq_products_id_vendor`/`uq_product_variants_id_vendor` already
  /// establish one level up. Additive: `id` is already unique, so this
  /// constrains nothing S2-6a previously allowed.
  @@unique([id, vendorId], map: "uq_product_media_id_vendor")
  /// One row per uploaded object; a vendor may re-upload under a fresh
  /// `ProductMedia` row freely, so there is no uniqueness constraint on the
  /// key beyond the primary key itself.
  @@index([productId], map: "idx_product_media_product")
  @@map("product_media")
}

/// One generated variant of a `ProductMedia` (S2-6b, SDD 12.2 step 5f: "200/
/// 400/800/1600 px, WebP + AVIF" — 8 rows per ready media item, one per
/// `(width, format)` pair).
///
/// A row of its own rather than columns on `ProductMedia` — the matrix is
/// fixed-shape but each variant is independently produced, independently
/// retryable mid-pipeline (a worker resuming a partially-processed item skips
/// only the pairs that already have a row) and independently addressable for
/// S2-6c's later public delivery, the same "structured child gets its own
/// table" convention `ProductVariant`/`KycDocument`/`CategoryAttribute`
/// already establish in this codebase — never a JSON blob for a shape this
/// fixed.
///
/// `vendorId` is denormalised from `ProductMedia.vendorId`, the same
/// composite-FK technique every other child table here uses.
model ProductMediaVariant {
  id        String                    @id @db.Uuid
  mediaId   String                    @map("media_id") @db.Uuid
  vendorId  String                    @map("vendor_id") @db.Uuid
  width     Int
  format    ProductMediaVariantFormat
  objectKey String                    @map("object_key")
  sizeBytes Int                       @map("size_bytes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// The composite FK: both halves must match the same `ProductMedia` row.
  media ProductMedia @relation(fields: [mediaId, vendorId], references: [id, vendorId], onDelete: Restrict)

  /// The worker's idempotency key: a redelivered or retried job that has
  /// already written this pair does nothing the second time — the unique
  /// index is the arbiter, never a read-then-write existence check.
  @@unique([mediaId, width, format], map: "uq_product_media_variants_media_width_format")
  @@index([mediaId], map: "idx_product_media_variants_media")
  @@map("product_media_variants")
}

/// Per-variant stock (SDD 6.3 "Stock", SDD 6.4, FR-12).
///
/// A separate row per variant rather than columns on `product_variants`,
/// exactly as SDD 6.3 prescribes: "Isolates the hot row from the wide product
/// row; makes the atomic decrement cheap." The primary key is `variant_id`
/// alone — SDD 6.4's "single-row lookup for the hot decrement path".
///
/// `vendor_id` is denormalised and pinned by the composite foreign key below,
/// the same technique `product_variants` uses against `products`. It is what
/// lets the RLS policy be a column comparison rather than a subquery — which
/// matters more here than anywhere else, because this is the row every
/// checkout in the system will contend on.
///
/// **Two `CHECK` constraints, and they are the point.** SDD 14.4 is explicit
/// that the conditional decrement is "Backed by `CHECK (… >= 0)`, so the
/// database itself makes overselling impossible regardless of application
/// bugs." `reserved` carries the symmetric constraint.
///
/// `version` exists for optimistic concurrency on the *vendor-facing* set
/// (S2-4): a stale `PATCH` affects zero rows and is refused. It is
/// deliberately **not** what the Stage 3 checkout decrement will use — that is
/// SDD 14.4's single atomic conditional `UPDATE … WHERE available >= :qty`,
/// which needs no version at all.
///
/// No `deleted_at`: this is a counter belonging to a variant, not a
/// user-visible entity of its own. It is created with its variant and removed
/// with it, in the same transaction.
model Inventory {
  variantId String @id @map("variant_id") @db.Uuid
  vendorId  String @map("vendor_id") @db.Uuid
  available Int    @default(0)
  reserved  Int    @default(0)
  version   Int    @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// `Restrict`, matching every other catalogue foreign key: a variant with a
  /// live inventory row must not vanish out from under it. The use cases
  /// remove the counter in the same transaction as the variant instead.
  variant ProductVariant @relation(fields: [variantId, vendorId], references: [id, vendorId], onDelete: Restrict)

  /// Required by Prisma to express the one-to-one above as a composite
  /// relation. Logically redundant — `variant_id` is already the primary key,
  /// so the pair is unique by construction — but it is what lets the foreign
  /// key pin `vendor_id` to the variant's own.
  @@unique([variantId, vendorId], map: "uq_inventory_variant_vendor")
  @@index([vendorId], map: "idx_inventory_vendor")
  @@map("inventory")
}

/// A customer's cart (S3-1, SDD 5 module 6: "cart"). One per customer — a
/// `UNIQUE` `user_id`, not a separate id lookup — since S3-1 has no guest-cart
/// or multi-cart concept to justify anything richer.
///
/// Deliberately outside `TENANT_SCOPED_MODELS`: a cart belongs to a customer,
/// not a vendor tenant, exactly like `Address` above. No RLS — ownership is
/// enforced in application code by `(id, userId)`/`(cartId, userId)` scoping,
/// the same convention `AddressRepository` already establishes.
model Cart {
  id        String   @id @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

/// One line in a cart (S3-1). `variantId` is a **plain UUID with no foreign
/// key** to `product_variants` — SDD 5.1 forbids a foreign key crossing a
/// module boundary except to the shared `users`/`vendors` identity anchors,
/// and `cart` and `catalogue` are separate modules (SDD 5). Existence and
/// eligibility (belongs to an `APPROVED`, non-deleted product) are checked at
/// write time against `catalogue`'s own repositories bound to the
/// `leenmart_public` read path, the same way price/tax will later be
/// snapshotted onto an order line rather than joined live.
///
/// No price/tax snapshot here (S3-1 explicitly excludes pricing/tax — SDD 5's
/// "price snapshot" cart responsibility is deferred, not silently dropped).
model CartItem {
  id        String    @id @db.Uuid
  cartId    String    @map("cart_id") @db.Uuid
  variantId String    @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  /// `uq_cart_items_cart_variant` — one live row per variant per cart, the
  /// database-level backing for "adding an already-present variant
  /// increments its quantity" rather than creating a second row — is
  /// deliberately absent here and hand-added only in the migration (a
  /// partial unique index, `WHERE deleted_at IS NULL`), the same way
  /// `idx_addresses_one_default_per_user` is: Prisma's schema DSL has no
  /// WHERE clause for indexes, so expressing it here would drift from the
  /// migration on the next `prisma migrate dev`.
  @@index([cartId], map: "idx_cart_items_cart")
  @@map("cart_items")
}

/// A commission rate effective from a point in time, for one vendor plan
/// (S3-2, SDD 5 module 7 "pricing-tax": `commission_rules`; D-S3-01).
///
/// Effective-dated and append-only rather than a single mutable rate column,
/// per D-S3-01's "configuration, not an irreversible hard-coded business
/// rule" and this schema's own stated convention that financial-adjacent
/// rows are corrected with a new row, never an edit (§6.1). Resolving the
/// rate that applied at a given instant is "the most recent row for this
/// plan with `effective_from <= asOf`" — deliberately no `effective_to`
/// column: closing the previous range on every insert is exactly the kind
/// of concurrent-write hazard an open-ended, append-only design avoids.
///
/// `rate_basis_points` (0–10000, i.e. 100.00% at 10000) is an integer, never
/// a float, matching this schema's money-adjacent convention — 10% is 1000,
/// 0% is 0. `Money.percentageOf()` (domain-kit) is what actually applies it.
///
/// The two rows the approved V1 baseline requires (`COMMISSION` → 1000 bps,
/// `SUBSCRIPTION` → 0 bps) are seeded by this migration — real, approved
/// figures, not placeholders (contrast `TaxRate` below, which starts empty).
model CommissionRule {
  id              String     @id @db.Uuid
  plan            VendorPlan
  rateBasisPoints Int        @map("rate_basis_points")
  effectiveFrom   DateTime   @map("effective_from") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  /// One rule per (plan, instant) — the database-level backing for
  /// "resolution is unambiguous", hand-added in the migration alongside the
  /// CHECK constraint Prisma's DSL cannot express.
  @@unique([plan, effectiveFrom], map: "uq_commission_rules_plan_effective_from")
  @@index([plan, effectiveFrom], map: "idx_commission_rules_plan_effective_from")
  @@map("commission_rules")
}

/// A GST/tax rate effective from a point in time, for one HSN/SAC
/// classification (S3-2, SDD 5 module 7 "pricing-tax": `tax_rates`; D-S3-05).
///
/// Keyed by `hsn_code`, not by product or variant: HSN is a nationwide GST
/// classification, not a per-vendor or per-listing attribute — the same
/// classification code applies to every seller's identically-classified
/// goods. `Product.hsnCode` (S2-3, nullable) is the existing lookup key;
/// this table is deliberately not a new per-product/variant column.
///
/// Same effective-dating shape as `CommissionRule` above, for the same
/// reason. **Starts genuinely empty** — D-S3-05 explicitly forbids
/// populating invented GST rates; every row here must be CA-approved before
/// it exists. Until a row exists for a given HSN code, tax resolution
/// returns an explicit unresolved state (`ResolveTaxUseCase`) rather than
/// guessing — this table having zero rows for months is the *expected*,
/// correct V1 state, not a bug.
model TaxRate {
  id              String   @id @db.Uuid
  hsnCode         String   @map("hsn_code") @db.VarChar(8)
  rateBasisPoints Int      @map("rate_basis_points")
  effectiveFrom   DateTime @map("effective_from") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([hsnCode, effectiveFrom], map: "uq_tax_rates_hsn_code_effective_from")
  @@index([hsnCode, effectiveFrom], map: "idx_tax_rates_hsn_code_effective_from")
  @@map("tax_rates")
}
