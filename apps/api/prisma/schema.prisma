// Leen Mart — Prisma schema (foundation baseline).
//
// No business entities are modelled here by design. This file establishes the
// conventions every future module must follow (SDD 6):
//
//   * UUID v7 primary keys, generated in the application, not the database, so
//     the ordering guarantee comes from one place (ADR-005).
//   * snake_case tables and columns via @map/@@map; camelCase in TypeScript.
//   * TIMESTAMPTZ everywhere, stored UTC.
//   * Money as BigInt minor units with an explicit currency column. Never Float.
//   * Soft delete via deleted_at on user-visible entities.
//   * Append-only financial and audit tables; corrections are new rows.
//
// The two tables below are platform infrastructure rather than business
// entities, and both are needed before any module can be built safely.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm, btree_gist]
}

/// Transactional outbox (SDD 4.2 / ADR-011).
///
/// Side effects are written in the same transaction as the business change, then
/// relayed asynchronously by the worker. This is what guarantees "if the order
/// committed, the notification will eventually send" without a distributed
/// transaction.
///
/// **Range-partitioned monthly on `created_at`** (SDD 6.4/6.5), applied in
/// `20260811233000_partition_audit_and_outbox`. The composite primary key is
/// forced by PostgreSQL for the same reason as `AuditLog`'s: a partitioned
/// table's primary key must contain every partition-key column. Nothing reads
/// this table yet, so no query is affected.
model OutboxEvent {
  id            String    @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(100)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(150)
  payload       Json
  metadata      Json?
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Partial index: the relay only ever scans unprocessed rows, so the index
  // stays small no matter how large the table grows.
  @@id([id, createdAt])
  @@index([processedAt, occurredAt], map: "idx_outbox_unprocessed")
  @@index([aggregateType, aggregateId], map: "idx_outbox_aggregate")
  // SDD 6.4 lists `(created_at)` for this table alongside `audit_logs`; it was
  // absent until now. Partitioning makes it earn its place twice over — it is
  // also the column every partition-pruned scan filters on.
  @@index([createdAt], map: "idx_outbox_created_at")
  @@map("outbox_events")
}

/// Identity module (first business module).
///
/// A single fixed role per user is sufficient for the nine roles the SDD's
/// role hierarchy defines (SDD 8.1); no permissions/roles join table is
/// modelled since nothing beyond fixed membership in one of these roles has
/// been requested. The permission matrix these roles feed (SDD 8.2) is
/// separate, out-of-scope-here policy, not part of this enum.
enum Role {
  CUSTOMER
  VENDOR_OWNER
  VENDOR_MANAGER
  VENDOR_STAFF
  SUPER_ADMIN
  CATALOGUE_MODERATOR
  FINANCE_ADMIN
  RISK_ANALYST
  SUPPORT_AGENT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
}

model User {
  id              String     @id @db.Uuid
  email           String?    @unique @db.VarChar(254)
  passwordHash    String?    @map("password_hash")
  phone           String?    @unique @db.VarChar(20)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  otps          Otp[]
  vendorProfile VendorProfile?
  mfaSecret     MfaSecret?
  mfaChallenges MfaChallenge[]
  addresses     Address[]

  @@map("users")
}

/// Opaque, hashed refresh tokens (SDD 6.1).
///
/// The raw token is never persisted, only its SHA-256 hash — the same
/// principle as a password, except Argon2 would be wasted work on a value
/// that is already 256 bits of randomness. `replacedById` records rotation so
/// a replayed, already-rotated token is a detectable signal, not just a
/// rejected one.
///
/// `family_id` is the rotation lineage that signal acts on (SDD 7.2: on
/// reuse detection "the entire session family is revoked"). A fresh login
/// roots a family at its own id and every rotation carries it forward, so a
/// family is exactly one login and its descendants — not every session the
/// user holds, which SDD 7.2 revokes under different triggers entirely.
/// Not a foreign key to itself: the root row can be deleted by retention
/// long before its descendants, and a family id that outlives its root is
/// correct rather than dangling.
model RefreshToken {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user")
  // Serves the one-statement family revocation on reuse detection. Plain
  // rather than partial: `family_id` is high-cardinality, so a family lookup
  // is already a handful of rows before the `revoked_at IS NULL` filter
  // narrows it to the single live one.
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@map("refresh_tokens")
}

/// One-time phone verification codes (SDD 7.1/7.3, Milestone 3 Step 2).
///
/// `codeHash` is the only representation of the code ever persisted — never
/// the raw 6-digit value, hashed with Argon2id (same reasoning as password
/// storage: the code space is small enough that a fast hash would be
/// brute-forceable offline). `attempts`/`expiresAt`/`consumedAt` mirror the
/// domain `Otp` entity's own invariants (5-minute validity, 5 max attempts,
/// single use) exactly; this table only stores that state, it never decides
/// it.
model Otp {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_otps_user")
  @@map("otps")
}

/// An administrator's TOTP secret (SDD 7.1: MFA is mandatory for every admin
/// role, always — never optional). `encrypted_secret` is ciphertext, never
/// the raw base32 secret; the key and cipher are out of scope for this
/// persistence-only chunk (Milestone 3 Step 5B) and land with the TOTP
/// service that first writes to this table. `user_id` is unique: exactly one
/// secret per user, the same one-to-one shape as `vendors.user_id`.
/// `confirmed_at` is null until the admin completes enrollment by proving
/// possession of the secret — a later chunk's concern, not this table's.
///
/// No `algorithm`/`digits`/`period` columns: TOTP's parameters are fixed
/// platform constants (approved design), not per-user configuration. No
/// recovery-code columns: recovery is operator-assisted break-glass (approved
/// design), which does not persist codes here.
model MfaSecret {
  id              String    @id @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  encryptedSecret String    @map("encrypted_secret")
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_secrets")
}

/// The record of an admin who has passed step 1 (password) of login and now
/// has one window to prove TOTP possession (SDD 7.1: mandatory TOTP, always).
/// Same shape SDD 7.3 already specifies for phone-OTP challenges — hashed,
/// 5-minute TTL, single use, max 5 attempts — applied here because the SDD
/// gives no separate MFA-challenge spec of its own. `token_hash` is a
/// high-entropy opaque bearer token's hash, the same pattern as
/// `refresh_tokens.token_hash`, not a low-entropy code like `otps.code_hash`.
/// No TOTP code or secret is ever stored here: verification is computed live
/// against `mfa_secrets`, never persisted mid-flight.
model MfaChallenge {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_mfa_challenges_user")
  @@map("mfa_challenges")
}

/// Vendor module (SDD 5, module 3).
///
/// The onboarding lifecycle of SDD 15.1. Deliberately not `UserStatus`: a
/// vendor answers a longer, KYC-driven question than a user account ever
/// does, and one shared type would make impossible states (a `LOCKED`
/// vendor, a `KYC_UNDER_REVIEW` user) representable.
enum VendorStatus {
  REGISTERED
  KYC_SUBMITTED
  KYC_UNDER_REVIEW
  KYC_REJECTED
  KYC_APPROVED
  ACTIVE
  SUSPENDED
  TERMINATED
}

/// A vendor's onboarding record (SDD 15.1).
///
/// `user_id` is unique: a single account may hold at most one vendor
/// profile, which is what makes the application's `findByUserId` duplicate
/// guard a database guarantee rather than a race-prone check. The foreign
/// key to `users` is one of the two module-crossing keys SDD 6.7 explicitly
/// permits (`users`/`vendors` are the shared identity anchors).
///
/// Only the columns registration actually writes exist here. KYC documents,
/// shops, business hours and trust scores (SDD 5, module 3) arrive with the
/// chunks that implement them.
model VendorProfile {
  id        String       @id @db.Uuid
  userId    String       @unique @map("user_id") @db.Uuid
  status    VendorStatus @default(REGISTERED)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vendors")
}

/// A customer's saved delivery address (SDD Stage 1: "customer profile and
/// address book"). No `customer` FR elaborates a distinct schema, so the
/// field list follows the standard e-commerce address-book shape SDD's
/// architecture already anticipates (Pincode as a first-class concept).
///
/// No lat/lng columns: no geocoding provider is configured yet, and
/// unpopulated nullable columns would be exactly the kind of speculative
/// field this schema otherwise avoids — added when the geocoding chunk
/// actually needs them.
///
/// Soft delete via `deleted_at`, per this schema's own stated convention
/// (top of file) — an address a customer has used on a past order must
/// remain resolvable, not vanish out from under order history.
///
/// `is_default` is enforced to at most one **active** row per user by
/// `idx_addresses_one_default_per_user`, a partial unique index added by
/// hand in this model's migration (Prisma's schema DSL has no `WHERE`
/// clause for indexes) — the same "database is the final arbiter of a
/// concurrent race" pattern `mfa_challenges.consumeIfActive` already
/// established, not a new one.
model Address {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  recipientName String    @map("recipient_name") @db.VarChar(100)
  phone         String    @db.VarChar(20)
  line1         String    @map("line_1") @db.VarChar(200)
  line2         String?   @map("line_2") @db.VarChar(200)
  city          String    @db.VarChar(100)
  state         String    @db.VarChar(100)
  pincode       String    @db.VarChar(6)
  landmark      String?   @db.VarChar(200)
  label         String    @db.VarChar(50)
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_addresses_user")
  @@map("addresses")
}

/// Immutable admin action log (SDD 18.4).
///
/// A domain artefact rather than an application log: queryable by admins,
/// retained eight years, and legally significant in a dispute.
///
/// Append-only: UPDATE, DELETE and TRUNCATE are all rejected by triggers added
/// in `20260811120000_audit_log_immutability`, not here — Prisma's schema DSL
/// cannot express a trigger, so the migration is the only place this control
/// can live. Corrections are new rows describing the correction, never edits.
///
/// **Range-partitioned monthly on `created_at`** (SDD 6.4/6.5), applied in
/// `20260811233000_partition_audit_and_outbox`. Prisma cannot express
/// `PARTITION BY RANGE` either, so that migration is likewise the only place
/// the partitioning itself lives — this model describes the resulting shape so
/// the generated client stays accurate.
///
/// The composite primary key is a consequence, not a choice: PostgreSQL
/// requires every unique or primary key on a partitioned table to contain all
/// partition-key columns, so `(id)` necessarily becomes `(id, created_at)`.
/// `id` remains the domain identity — no repository query looks a row up by
/// primary key, so nothing in the application observes the difference.
model AuditLog {
  id             String   @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actorRole      String   @map("actor_role") @db.VarChar(50)
  impersonatedBy String?  @map("impersonated_by") @db.Uuid
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String?  @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  reason         String?
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent")
  requestId      String?  @map("request_id") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([id, createdAt])
  @@index([actorId, createdAt], map: "idx_audit_actor")
  @@index([entityType, entityId, createdAt], map: "idx_audit_entity")
  @@index([createdAt], map: "idx_audit_created_at")
  @@map("audit_logs")
}
