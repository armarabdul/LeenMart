NODE_ENV=test
SERVICE_NAME=leen-mart-api
APP_VERSION=0.0.0-test
PORT=4001
LOG_LEVEL=error
LOG_PRETTY=false
DATABASE_URL=postgresql://leenmart:leenmart@localhost:5432/leenmart_test?schema=public
REDIS_URL=redis://localhost:6379/1
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=test-only-insecure-jwt-access-secret-change-me-please
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_DAYS=30
ADMIN_SESSION_IDLE_TIMEOUT_MINUTES=30
MFA_ENCRYPTION_KEY=abababababababababababababababababababababababababababababababab

# --- Runtime database roles (KYC-2B-1) ---
# DATABASE_URL above is the OWNER connection: migrations and schema tools only.
# It is SUPERUSER/BYPASSRLS, so serving requests on it skips row-level security
# entirely. The two below are the restricted runtime roles.
#
# Provision them with:
#   pnpm --filter @leen-mart/api db:migrate:deploy    # creates the roles
#   pnpm --filter @leen-mart/api db:provision-roles   # sets their passwords
#
# The password is read from these URLs, so there is one source of truth per
# role. Local values are deliberately non-production placeholders; production
# is refused if either is unset or equal to DATABASE_URL.
APP_DATABASE_URL=postgresql://leenmart_app:leenmart_app_dev@localhost:5432/leenmart_test?schema=public
ADMIN_DATABASE_URL=postgresql://leenmart_admin:leenmart_admin_dev@localhost:5432/leenmart_test?schema=public
# leenmart_public (S2-7): unauthenticated public search/read, SELECT-only.
PUBLIC_DATABASE_URL=postgresql://leenmart_public:leenmart_public_dev@localhost:5432/leenmart_test?schema=public
# leenmart_checkout (S3-3A): the narrow role PlaceOrderUseCase runs under.
CHECKOUT_DATABASE_URL=postgresql://leenmart_checkout:leenmart_checkout_dev@localhost:5432/leenmart_test?schema=public
