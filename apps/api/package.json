{
  "name": "@leen-mart/api",
  "version": "0.1.0",
  "private": true,
  "description": "Leen Mart HTTP API — Clean Architecture foundation",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:watch": "vitest --project unit",
    "bootstrap:admin": "tsx src/cli/bootstrap-admin.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:provision-roles": "tsx src/cli/provision-db-roles.ts",
    "db:studio": "prisma studio",
    "db:format": "prisma format",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1108.0",
    "@aws-sdk/client-s3": "3.1108.0",
    "@aws-sdk/s3-request-presigner": "3.1108.0",
    "@leen-mart/contracts": "workspace:*",
    "@leen-mart/domain-kit": "workspace:*",
    "@prisma/client": "6.3.0",
    "argon2": "0.41.1",
    "compression": "1.7.5",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "otplib": "13.4.1",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "rate-limit-redis": "4.2.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@leen-mart/config": "workspace:*",
    "@types/compression": "1.7.5",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/express-serve-static-core": "5.1.3",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.5",
    "@types/supertest": "6.0.2",
    "eslint": "9.18.0",
    "pino-pretty": "13.0.0",
    "prisma": "6.3.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
