# ---------------------------------------------------------------------------
# Leen Mart API — environment configuration
#
# Copy to .env for local development:  cp .env.example .env
# Every variable below is validated by src/shared/config/env.ts at process
# start. The service refuses to boot if any of them is missing or malformed.
# ---------------------------------------------------------------------------

# --- runtime ---
NODE_ENV=development
SERVICE_NAME=leen-mart-api
APP_VERSION=0.1.0
PORT=4000
HOST=0.0.0.0
SHUTDOWN_TIMEOUT_MS=30000
BODY_LIMIT=1mb
# Number of proxies in front of the app (ALB + Cloudflare = 2 in production).
# Never set this to a value larger than reality: it lets clients spoof their IP.
TRUST_PROXY=1

# --- observability ---
LOG_LEVEL=debug
# Human-readable logs locally; must be false in production (JSON only).
LOG_PRETTY=true

# --- data stores ---
DATABASE_URL=postgresql://leenmart:leenmart@localhost:5432/leenmart?schema=public
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379

# --- http ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000

# --- identity ---
# Dev-only placeholder; refused in production if left unchanged (min 32 chars).
JWT_ACCESS_SECRET=dev-only-insecure-jwt-access-secret-change-me-please
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_DAYS=30
# SDD 7.5's admin-console idle timeout: the sliding window an admin refresh
# token gets instead of JWT_REFRESH_TTL_DAYS. Every rotation restarts it.
ADMIN_SESSION_IDLE_TIMEOUT_MINUTES=30
# Dev-only placeholder; refused in production if left unchanged. Must be a
# 64-character hex string (32 bytes) — AES-256-GCM key for admin MFA secrets.
MFA_ENCRYPTION_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# --- KYC object storage (SDD 12.1/12.2) ---
# S3-compatible. MinIO locally (see infra/docker/docker-compose.yml), Cloudflare
# R2 in production — the same adapter serves both; only these values differ.
KYC_S3_ENDPOINT=http://localhost:9000
KYC_S3_REGION=auto
KYC_S3_BUCKET=leenmart-private-kyc
KYC_S3_ACCESS_KEY_ID=leenmart
# Dev-only placeholder; refused in production if left unchanged.
KYC_S3_SECRET_ACCESS_KEY=leenmart-dev-secret
KYC_S3_FORCE_PATH_STYLE=true

# --- KYC envelope encryption (SDD 12.1/12.3) ---
# The KMS-managed CMK that wraps every per-object data key. Required in
# production; left unset locally, where the development cipher is used instead.
# KYC_KMS_KEY_ID=
KYC_KMS_REGION=ap-south-1
# Development only. Selects DevDataKeyCipher over KMS; production refuses it,
# and the cipher itself refuses to construct there.
KYC_USE_DEV_DATA_KEY_CIPHER=true
# Dev-only wrapping key for that substitute — never the production KYC key, and
# deliberately distinct from MFA_ENCRYPTION_KEY. 64-character hex (32 bytes).
KYC_DEV_WRAPPING_KEY=feedfacefeedfacefeedfacefeedfacefeedfacefeedfacefeedfacefeedface

# --- KYC duplicate detection (SEC-17) ---
# HMAC-SHA256 key for PAN/bank fingerprints. A third distinct secret: sharing it
# with MFA_ENCRYPTION_KEY, the KMS CMK or JWT_ACCESS_SECRET would make one leak
# defeat two controls. Production refuses this development value.
#
# This one can never be rotated in place — a new pepper produces different
# digests for the same PAN, so every stored fingerprint stops matching.
KYC_FINGERPRINT_PEPPER=c0ffee42c0ffee42c0ffee42c0ffee42c0ffee42c0ffee42c0ffee42c0ffee42

# --- Runtime database roles (KYC-2B-1 / S2-7) ---
# DATABASE_URL above is the OWNER connection: migrations and schema tools only.
# It is SUPERUSER/BYPASSRLS, so serving requests on it skips row-level security
# entirely. The three below are the restricted runtime roles.
#
# Provision them with:
#   pnpm --filter @leen-mart/api db:migrate:deploy    # creates the roles
#   pnpm --filter @leen-mart/api db:provision-roles   # sets their passwords
#
# The password is read from these URLs, so there is one source of truth per
# role. Local values are deliberately non-production placeholders; production
# is refused if any is unset or equal to DATABASE_URL.
APP_DATABASE_URL=postgresql://leenmart_app:leenmart_app_dev@localhost:5432/leenmart?schema=public
ADMIN_DATABASE_URL=postgresql://leenmart_admin:leenmart_admin_dev@localhost:5432/leenmart?schema=public
# leenmart_public (S2-7): unauthenticated public search/read, SELECT-only,
# structurally restricted by RLS to APPROVED/READY, non-deleted rows.
PUBLIC_DATABASE_URL=postgresql://leenmart_public:leenmart_public_dev@localhost:5432/leenmart?schema=public
# leenmart_checkout (S3-3A): the narrow role PlaceOrderUseCase runs under —
# SELECT on vendors, UPDATE on inventory only, full DML on orders/sub_orders/
# order_items/idempotency_keys, INSERT on outbox_events. No grant at all on
# KYC, catalogue mutation, users or any admin table.
CHECKOUT_DATABASE_URL=postgresql://leenmart_checkout:leenmart_checkout_dev@localhost:5432/leenmart?schema=public
