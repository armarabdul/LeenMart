# ---------------------------------------------------------------------------
# Leen Mart admin console — environment configuration
#
# Only VITE_-prefixed variables reach the browser bundle. Never put a secret
# here: everything in this file is publicly readable in the shipped JavaScript.
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:4000
VITE_APP_NAME=Leen Mart Admin Console
VITE_APP_VERSION=0.1.0
VITE_ENVIRONMENT=development
