# ---------------------------------------------------------------------------
# Leen Mart vendor portal — environment configuration
#
# Only VITE_-prefixed variables reach the browser bundle. Never put a secret
# here: everything in this file is publicly readable in the shipped JavaScript.
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:4000
VITE_APP_NAME=Leen Mart Vendor Portal
VITE_APP_VERSION=0.1.0
VITE_ENVIRONMENT=development

# The public half of the API's PICKUP_TOKEN_PRIVATE_KEY/PICKUP_TOKEN_PUBLIC_KEY
# keypair (S4-QR) — must match whatever the API is actually configured with.
# Not a secret: a public key can verify a pickup token locally but never sign
# one. Defaults to the same insecure dev keypair the API defaults to.
VITE_PICKUP_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEAQADYhCP8GEfDElt7kbLWxtRx0B6odWvdhpLp5m2xI8k=
-----END PUBLIC KEY-----"
