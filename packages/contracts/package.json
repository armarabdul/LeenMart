{
  "name": "@leen-mart/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Zod schemas and inferred DTOs shared by the API and every client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@leen-mart/config": "workspace:*",
    "@types/node": "22.10.5",
    "eslint": "9.18.0",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
