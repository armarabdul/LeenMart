{
  "name": "@leen-mart/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared build, lint and test configuration presets",
  "type": "module",
  "exports": {
    "./eslint/base": "./eslint/base.js",
    "./eslint/node": "./eslint/node.js",
    "./eslint/react": "./eslint/react.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/react.json": "./tsconfig/react.json"
  },
  "files": [
    "eslint",
    "tsconfig"
  ],
  "scripts": {
    "build": "echo \"(config) nothing to build — presets are consumed as source\"",
    "lint": "echo \"(config) no lintable sources\"",
    "typecheck": "echo \"(config) no typecheck\"",
    "test": "echo \"(config) no tests\"",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@eslint/js": "9.18.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "typescript-eslint": "8.20.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.7.0"
  }
}
